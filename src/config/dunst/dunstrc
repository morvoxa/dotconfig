[global]
    ### Layout & Positioning ###
    origin = top-right
    offset = (20, 50)
    width = 360
    height = (0, 110)
    notification_limit = 5
    
    ### Aesthetics & Colors ###
    font = JetBrains Mono Nerd Font 10
    corner_radius = 14
    frame_width = 1
    padding = 16
    horizontal_padding = 16
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48
    
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    gap_size = 8
    sort = yes

[urgency_low]
    background = "#1e1e1e"
    foreground = "#ffffff"
    frame_color = "#3a3a3c"
    timeout = 3

[urgency_normal]
    background = "#1e1e1e"
    foreground = "#ffffff"
    frame_color = "#3a3a3c"
    timeout = 3

[urgency_critical]
    background = "#1e1e1e"
    foreground = "#ffffff"
    frame_color = "#ff453a"
    timeout = 0
