input="$*"
if [ -z "$input" ]; then
  read -p "Enter commit message: " input
fi

scope=$(echo "$input" | awk '{print $1}')
message=$(echo "$input" | cut -d' ' -f2-)
formatted_msg="[$scope]: $message"
echo "Proposed commit message:"
echo "$formatted_msg"
echo ""
read -p "Do you want to run git add, commit, and push? (y/n): " confirm
if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
  git add .
  git commit -m "$formatted_msg"
  git push
  echo "Git add, commit, and push completed."
else
  echo "Process aborted."
fi
