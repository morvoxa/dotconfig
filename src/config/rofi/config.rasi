configuration {
    modi: "run,drun,window";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: "     Window ";
    sidebar-mode: true;
}

* {
    /* Color Palette matching Dunst normal/low urgency */
    bg-color:            #1e1e1e;
    fg-color:            #ffffff;
    border-color:        #3a3a3c;
    
    /* Active/Selection states matching macOS high-contrast accents */
    selected-bg:         #3a3a3c;
    selected-fg:         #ffffff;

    /* Clean typography mirroring your Dunst font layout */
    font: "JetBrains Mono Nerd Font 10";
}

window {
    height:              420px;
    width:               600px;
    border:              1px;
    border-radius:       14px;  /* Matches Dunst corner_radius */
    border-color:        @border-color;
    background-color:    @bg-color;
    padding:             16px;  /* Matches Dunst padding */
}

mainbox {
    background-color:    @bg-color;
    children:            [ inputbar, listview, mode-switcher ];
}

inputbar {
    children:            [ prompt, entry ];
    background-color:    @bg-color;
    border-radius:       8px;
    padding:             2px;
}

prompt {
    background-color:    @selected-bg;
    padding:             8px;
    text-color:          @fg-color;
    border-radius:       8px;
    margin:              10px 0px 0px 10px;
}

entry {
    padding:             8px;
    margin:              10px 10px 0px 10px;
    text-color:          @fg-color;
    background-color:    @bg-color;
    placeholder:         "Search...";
    placeholder-color:   #555555;
}

listview {
    border:              0px;
    padding:             10px 0px 0px;
    margin:              10px 10px 0px 10px;
    columns:             1;
    lines:               8;
    background-color:    @bg-color;
}

element {
    padding:             10px; /* Matches layout proportions */
    background-color:    @bg-color;
    text-color:          @fg-color;
    border-radius:       8px;
}

element-icon {
    size:                24px; /* Scaled down proportionally from Dunst 48px */
}

element selected {
    background-color:    @selected-bg;
    text-color:          @selected-fg;
}

mode-switcher {
    spacing:             10px;
    padding:             10px 10px 0px 10px;
}

button {
    padding:             8px;
    background-color:    @bg-color;
    text-color:          #888888;
    vertical-align:      0.5; 
    horizontal-align:    0.5;
}

button selected {
  background-color:      @selected-bg;
  text-color:            @selected-fg;
  border-radius:         8px;
}
