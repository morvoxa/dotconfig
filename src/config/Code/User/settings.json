{
  //esbenp.prettier-vscode
  //guichina.code-telescope
  //haphazarddev.oil-code
  //johnnymorganz.stylua
  //llvm-vs-code-extensions.vscode-clangd
  //rust-lang.rust-analyzer
  //tamasfe.even-better-toml
  //vitchu.vscode-autohide-vim
  //Vim
  "vim.useSystemClipboard": true,
  "vim.smartcase": false,
  "vim.ignorecase": true,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.terminal.toggleTerminal"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["oil-code.open"]
    },
    {
      "before": ["<leader>", "r"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["<leader>", "b"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "n", "h"],
      "commands": [":nohl"]
    }
  ],
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/? ",

  // Clean Ui
  "editor.fontFamily": "JetBrainsMono Nerd Font, monospace",
  "editor.fontLigatures": true,
  "chat.disableAIFeatures": true,
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "hidden",
  "breadcrumbs.enabled": false,
  "window.commandCenter": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "workbench.layoutControl": false,
  "editor.glyphMargin": false,
  "window.titleBarStyle": "native",
  "window.windowControlsVisibility": "custom",
  "editor.lineNumbers": "relative",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "window.menuBarVisibility": "hidden",
  //oil config
  "oil-code.disableOpenCwdNothingOpen": true,
  "oil-code.hasNerdFont": true,
  "oil-code.columns": ["icon", "permissions", "size", "mtime"],
  // Formatter config
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[rust]": {
    "editor.semanticHighlighting.enabled": false,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "svelte.enable-ts-plugin": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  }
}
